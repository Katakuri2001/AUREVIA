{
  "name": "aurevia",
  "version": "0.1.0",
  "private": true,
  "description": "AUREVIA — an immersive digital marketing agency experience on Next.js and Cloudflare Workers.",
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "npm run typecheck && npm run lint && npm run build && opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:seed": "tsx scripts/seed.ts",
    "db:seed:remote": "SEED_REMOTE=1 tsx scripts/seed.ts",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.6",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "bcryptjs": "3.0.3",
    "gsap": "3.15.0",
    "hls.js": "^1.7.3",
    "lenis": "1.3.26",
    "lucide-react": "0.468.0",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.186.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260922.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "autoprefixer": "10.6.1",
    "eslint": "9.11.0",
    "eslint-config-next": "16.3.5",
    "postcss": "8.5.28",
    "tailwindcss": "4.3.3",
    "tsx": "4.20.0",
    "typescript": "5.9.3",
    "wrangler": "4.136.1"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
