# AUREVIA environment reference
# Copy this file to .env.local for local Next.js development.
# Never commit real secrets or production credentials.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXTJS_ENV=development

# Cloudflare bindings are supplied by Wrangler during Workers preview/deploy.
# Do not put Cloudflare API tokens in this file.

# Demo administrator bootstrap.
# The seed command hashes this value before writing it to D1.
ADMIN_EMAIL=admin@aurevia.demo
ADMIN_PASSWORD=ChangeMe-In-Production-2026!

# Optional anti-spam integration.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
